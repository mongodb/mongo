# Cross-compilation toolchain for building macOS binaries on Linux
# This is a placeholder BUILD file; the actual toolchain is generated by the repository rule.

load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

exports_files(["macos_cross_action_wrapper.py"])

sh_binary(
    name = "macos_cross_action_wrapper_sh",
    srcs = ["macos_cross_action_wrapper.py"],
    data = [
        "//bazel:hermetic_container/container_paths.py",
        "//bazel/toolchains/cc:container_action.py",
        "//bazel/toolchains/cc:container_action_scripts",
        "//bazel/toolchains/cc:container_engine.py",
        "//bazel/toolchains/cc:container_mounts.py",
    ],
)

py_binary(
    name = "macos_cross_action_wrapper",
    srcs = ["macos_cross_action_wrapper.py"],
    main = "macos_cross_action_wrapper.py",
    deps = ["//bazel/toolchains/cc:container_runtime"],
)
