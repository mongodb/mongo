load("//bazel/toolchains/cc/mongo_linux:mongo_compiler_flags.bzl", "COMPRESS_DEBUG_COPTS")
load(":mongo_linux_cross_toolchain_test.bzl", "gold_sysroot_script_test", "matrix_test")
load(":target_platform_check.bzl", "s390x_target_platform_check")

exports_files(glob([
    "*.bzl",
    "*.tmpl",
]))

matrix_test(name = "cross_toolchain_matrix_test")

gold_sysroot_script_test(name = "gold_sysroot_script_test")

s390x_target_platform_check(
    name = "s390x_target_platform_check",
    target_compatible_with = ["@platforms//cpu:s390x"],
)

cc_binary(
    name = "cross_smoke",
    testonly = True,
    srcs = ["cross_smoke.cpp"],
    copts = COMPRESS_DEBUG_COPTS,
    target_compatible_with = ["@platforms//cpu:s390x"],
    deps = [":cross_smoke_library"],
)

cc_library(
    name = "cross_smoke_library",
    testonly = True,
    srcs = ["cross_smoke_library.cpp"],
    copts = COMPRESS_DEBUG_COPTS,
    target_compatible_with = ["@platforms//cpu:s390x"],
)

# Exercise shared-library linking and --start-lib without calling target libc.
cc_binary(
    name = "cross_linker_smoke",
    testonly = True,
    srcs = ["cross_linker_smoke.cpp"],
    copts = COMPRESS_DEBUG_COPTS,
    features = ["-pie"],
    linkopts = [
        "-nostdlib",
        "-Wl,-z,defs",
    ],
    linkshared = True,
    target_compatible_with = ["@platforms//cpu:s390x"],
    deps = [":cross_smoke_library"],
)
