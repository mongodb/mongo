load(":mongo_linux_cross_toolchain_test.bzl", "matrix_test")
load(":target_platform_check.bzl", "ppc64le_target_platform_check", "s390x_target_platform_check")

exports_files(glob([
    "*.bzl",
    "*.tmpl",
]))

matrix_test(name = "cross_toolchain_matrix_test")

s390x_target_platform_check(
    name = "s390x_target_platform_check",
    target_compatible_with = ["@platforms//cpu:s390x"],
)

cc_binary(
    name = "cross_smoke",
    testonly = True,
    srcs = ["cross_smoke.cpp"],
    target_compatible_with = ["@platforms//cpu:s390x"],
    deps = [":cross_smoke_library"],
)

cc_library(
    name = "cross_smoke_library",
    testonly = True,
    srcs = ["cross_smoke_library.cpp"],
    target_compatible_with = ["@platforms//cpu:s390x"],
)

# Exercise shared-library linking and --start-lib without calling target libc.
cc_binary(
    name = "cross_linker_smoke",
    testonly = True,
    srcs = ["cross_linker_smoke.cpp"],
    linkopts = [
        "-nostdlib",
        "-Wl,-z,defs",
    ],
    linkshared = True,
    target_compatible_with = ["@platforms//cpu:s390x"],
    deps = [":cross_smoke_library"],
)

ppc64le_target_platform_check(
    name = "ppc64le_target_platform_check",
    target_compatible_with = ["@platforms//cpu:ppc"],
)

cc_binary(
    name = "ppc64le_cross_smoke",
    testonly = True,
    srcs = [
        "ppc64le_cross_smoke.cpp",
        "//src/mongo:mongo_config_header",
        "//src/mongo/db/fts/unicode:byte_vector_altivec.h",
        "//src/mongo/platform:bits.h",
        "//src/mongo/platform:compiler.h",
        "//src/mongo/util:modules.h",
    ],
    copts = [
        "-Isrc",
        "-I$(GENDIR)/src",
    ],
    target_compatible_with = ["@platforms//cpu:ppc"],
)
