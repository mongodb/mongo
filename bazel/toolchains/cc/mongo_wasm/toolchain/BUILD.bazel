load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":cc_toolchain_config_wasip2.bzl", "wasi_cc_toolchain_config_wasip2")
load(":wasi_repo_test.bzl", "linux_tool_wrapper_fixture", "wasi_repo_test_suite")

package(default_visibility = ["//visibility:public"])

exports_files(["linux_tool_wrapper.sh"])

# --- WASI Preview2 (wasm32-wasip2) toolchain/platform ---

wasi_cc_toolchain_config_wasip2(
    name = "wasi_cc_toolchain_config_wasip2",
    ar = "@wasi_sdk//:llvm-ar",
    clang = "@wasi_sdk//:wasm32-wasip2-clang",
    clangpp = "@wasi_sdk//:wasm32-wasip2-clang++",
)

linux_tool_wrapper_fixture(
    name = "wasi_tool_wrapper_fixture",
    testonly = True,
)

sh_test(
    name = "wasi_tool_wrapper_test",
    srcs = ["wasi_tool_wrapper_test.sh"],
    args = [
        "$(location @wasi_sdk//:wasm32-wasip2-clang)",
        "$(location :wasi_tool_wrapper_fixture/bin/mongo-wasm32-wasip2-clang)",
        "$(location :wasi_tool_wrapper_fixture/bin/mongo-wasm32-wasip2-clang++)",
        "$(location :wasi_tool_wrapper_fixture/bin/mongo-llvm-ar)",
    ],
    data = [
        ":wasi_tool_wrapper_fixture/bin/mongo-llvm-ar",
        ":wasi_tool_wrapper_fixture/bin/mongo-wasm32-wasip2-clang",
        ":wasi_tool_wrapper_fixture/bin/mongo-wasm32-wasip2-clang++",
        "@wasi_sdk//:bin",
        "@wasi_sdk//:lib",
        "@wasi_sdk//:share",
        "@wasi_sdk//:wasm32-wasip2-clang",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_toolchain(
    name = "wasi_cc_toolchain_wasip2_impl",
    all_files = ":wasi_files",
    ar_files = ":wasi_files",
    as_files = ":wasi_files",
    compiler_files = ":wasi_files",
    dwp_files = ":empty",
    linker_files = ":wasi_files",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
    toolchain_config = ":wasi_cc_toolchain_config_wasip2",
    toolchain_identifier = "wasi_sdk_cc_wasip2",
)

toolchain(
    name = "wasi_cc_toolchain_wasip2",
    target_compatible_with = [
        "@platforms//os:wasi",
        "@platforms//cpu:wasm32",
    ],
    toolchain = ":wasi_cc_toolchain_wasip2_impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Empty group to satisfy cc_toolchain’s file sets we don’t use.
filegroup(name = "empty")

wasi_repo_test_suite(name = "wasi_repo_test")

# Files the toolchain “has”; pointing at the repo we fetched.
filegroup(
    name = "wasi_files",
    srcs = [
        "@wasi_sdk//:bin",
        "@wasi_sdk//:include",
        "@wasi_sdk//:lib",
        "@wasi_sdk//:share",
    ],
)
