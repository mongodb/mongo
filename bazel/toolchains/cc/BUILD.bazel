load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load(":libcxx_config_test.bzl", "libcxx_vendor_availability_test")

package(default_visibility = ["//visibility:public"])

libcxx_vendor_availability_test(
    name = "libcxx_vendor_availability_test",
)

py_test(
    name = "macos_unwind_test",
    size = "small",
    srcs = ["macos_unwind_test.py"],
    args = [
        "$(rootpath @mongo_toolchain_v5//:v5/bin/clang)",
        "$(rootpath @mongo_toolchain_v5//:v5/bin/ld64.lld)",
        "$(rootpath @mongo_toolchain_v5//:v5/bin/llvm-objdump)",
    ],
    data = [
        "macos_link_flags.bzl",
        "@mongo_toolchain_v5//:v5/bin/clang",
        "@mongo_toolchain_v5//:v5/bin/ld64.lld",
        "@mongo_toolchain_v5//:v5/bin/llvm-objdump",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

exports_files([
    "container_action.py",
    "container_engine.py",
    "container_mounts.py",
    "libcxx_config.bzl",
    "macos_link_flags.bzl",
])

py_library(
    name = "container_action",
    srcs = ["container_action.py"],
    data = [":container_action_scripts"],
)

filegroup(
    name = "container_action_scripts",
    srcs = [
        "scripts/action_supervisor.sh",
        "scripts/input_probe.sh",
        "scripts/input_probe_setup.sh",
        "scripts/mount_windows_drives.sh",
    ],
)

py_library(
    name = "container_runtime",
    srcs = [
        "container_engine.py",
        "container_mounts.py",
    ],
    deps = [
        ":container_action",
        "//bazel:container_paths",
    ],
)

py_test(
    name = "container_engine_test",
    srcs = ["container_engine_test.py"],
    main = "container_engine_test.py",
    deps = [":container_runtime"],
)

py_test(
    name = "container_mounts_test",
    srcs = ["container_mounts_test.py"],
    main = "container_mounts_test.py",
    deps = [":container_runtime"],
)

py_test(
    name = "container_action_test",
    srcs = ["container_action_test.py"],
    main = "container_action_test.py",
    deps = [":container_action"],
)

py_binary(
    name = "toolchain_version_probe",
    srcs = ["toolchain_version_probe.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "toolchain_version_manifest",
    srcs = ["toolchain_version_manifest.py"],
    deps = ["//buildscripts/package_test:toolchain_versions"],
)

py_test(
    name = "toolchain_version_probe_test",
    size = "small",
    srcs = [
        "toolchain_version_probe.py",
        "toolchain_version_probe_test.py",
    ],
)

py_test(
    name = "toolchain_version_manifest_test",
    size = "small",
    srcs = [
        "toolchain_version_manifest.py",
        "toolchain_version_manifest_test.py",
    ],
    deps = ["//buildscripts/package_test:toolchain_versions"],
)

# Cargo build scripts execute as native host tools. During a Windows cross build,
# the current C++ toolchain is the Linux cross toolchain used by remote C++
# actions, so expose the native toolchain explicitly for rules_rust.
alias(
    name = "cargo_build_script_cc_toolchain",
    actual = select({
        "//bazel/platforms:windows_cross": "@mongo_windows_toolchain//:mongo_win_cc_toolchain",
        "//conditions:default": "@bazel_tools//tools/cpp:current_cc_toolchain",
    }),
)
