load("@rules_python//python:defs.bzl", "py_runtime", "py_runtime_pair")
load("@//bazel/toolchains/python:runtime_toolchains.bzl", "python_runtime_toolchains")

exports_files(["availability.bzl"])

filegroup(
    name = "files",
    srcs = glob(
        # Keep the entire distribution in runfiles.  In particular, the
        # Windows python-build-standalone layout keeps python*.dll at dist/
        # and extension DLLs under dist/DLLs rather than dist/bin or dist/lib.
        include=["dist/**/*"],
        # bazel runfiles do not support paths with spaces
        # https://github.com/bazelbuild/bazel/issues/4327
        # The setuptools developers will not remove the spaces from these files
        # https://github.com/pypa/setuptools/issues/746
        exclude=[
            "**/setuptools/**/* *",
            "**/*.pyc",
{cross_linux_python_excludes}        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "interpreter",
    srcs = ["{interpreter_path}"],
    visibility = ["//visibility:public"],
)

py_runtime(
    name = "py_runtime",
    files = [":files"],
    interpreter = ":interpreter",
    python_version = "PY3",
    # rules_python recreates Windows venvs with a copy of python.exe. The image loader
    # needs these DLLs beside that copy before Python can read pyvenv.cfg.
    venv_bin_files = glob(["dist/*.dll"], allow_empty = True),
    visibility = ["//visibility:public"],
)

py_runtime_pair(
    name = "py_runtime_pair",
    py2_runtime = None,
    py3_runtime = ":py_runtime",
)

python_runtime_toolchains(
    name = "python_toolchain",
    constraints = [{constraints}],
    runtime_pair = ":py_runtime_pair",
    windows = {windows},
)
