# Patches applied to rules_pkg via single_version_override in MODULE.bazel.

exports_files([
    "pkg_tar_host_tool.patch",
    "pkg_tar_tool_override.patch",
    "pkg_zip_windows_dll_path.patch",
])

# Host-constrained build_tar helper for IBM cross-RBE.
#
# Install archives keep source mtimes, so their pkg_tar actions run locally on
# the client host. During PPC64LE and s390x cross-RBE builds that host is an
# IBM machine, while the default rules_pkg build_tar launcher is built for the
# x86_64 execution platform and cannot execute there. This variant constrains
# its own build to the local host platform (constraints generated by the
# setup_local_config_platform repo rule), so the launcher and its Python
# runtime are built for the machine that actually runs the action.
#
# The helper lives here and not in a rules_pkg patch because Bazel 9 bzlmod
# cannot resolve @local_config_platform from inside a module repository.
# See bazel/rules_pkg/pkg_tar_host_tool.patch.
load("@internal_platforms_do_not_use//host:constraints.bzl", "HOST_CONSTRAINTS")
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "build_tar_host",
    srcs = ["@rules_pkg//pkg/private/tar:build_tar.py"],
    exec_compatible_with = HOST_CONSTRAINTS,
    main = "@rules_pkg//pkg/private/tar:build_tar.py",
    precompile = "disabled",
    python_version = "PY3",
    srcs_version = "PY3",
    tags = [
        "local",
        "no-remote",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@rules_pkg//pkg/private:archive",
        "@rules_pkg//pkg/private:build_info",
        "@rules_pkg//pkg/private:helpers",
        "@rules_pkg//pkg/private:manifest",
        "@rules_pkg//pkg/private/tar:tar_writer",
    ],
)
