Resolve wheel-build HOME, caches, and temporary files inside the action at runtime.

Relative HOME is ignored by recent platformdirs. Resolve the disposable build
directory before changing cwd, and override path variables after build-env merging.
Keep scratch files inside the Bazel action even if the process is killed; preserve
rules_pycross's debug retention and normal success/failure cleanup.

diff --git a/pycross/private/tools/wheel_builder.py b/pycross/private/tools/wheel_builder.py
--- a/pycross/private/tools/wheel_builder.py
+++ b/pycross/private/tools/wheel_builder.py
@@ -747,6 +747,29 @@
     return Path(wheel_file)


+def _sandbox_environment(temp_dir: Path) -> Dict[str, str]:
+    """Resolve paths before a backend changes cwd; keep all state under the action."""
+    home = (temp_dir / "home").resolve()
+    cache = home / ".cache"
+    cargo = home / ".cargo"
+    tmp = (temp_dir / "tmp").resolve()
+    local = home / "AppData" / "Local"
+    roaming = home / "AppData" / "Roaming"
+    for directory in (home, cache, cargo, tmp, local, roaming):
+        directory.mkdir(parents=True, exist_ok=True)
+    return {
+        "HOME": str(home),
+        "USERPROFILE": str(home),
+        "CARGO_HOME": str(cargo),
+        "XDG_CACHE_HOME": str(cache),
+        "LOCALAPPDATA": str(local),
+        "APPDATA": str(roaming),
+        "TMPDIR": str(tmp),
+        "TEMP": str(tmp),
+        "TMP": str(tmp),
+    }
+
+
 def init_build_env_vars(
     args: Any,
     temp_dir: Path,
@@ -766,6 +789,9 @@
         for key, val in additional_build_env.items():
             set_or_append(vars, key, val)

+    # Override path variables after merging build_env, which appends existing values.
+    vars.update(_sandbox_environment(temp_dir))
+
     vars["PYCROSS_INCLUDE_PATH"] = os.pathsep.join(map(str, include_dirs))
     vars["PYCROSS_LIBRARY_PATH"] = os.pathsep.join(map(str, lib_dirs))
     vars["PYCROSS_BAZEL_ROOT"] = str(bazel_root)
@@ -864,7 +890,10 @@

     # Extract the sdist and rename it to 'sdist'
     sdist_dir = temp_dir / "sdist"
-    _sdist_extracted_dir = extract_sdist(args.sdist, temp_dir)
+    # Keep extraction separate from the home/cache directories already in temp_dir.
+    extract_dir = temp_dir / "extract"
+    extract_dir.mkdir()
+    _sdist_extracted_dir = extract_sdist(args.sdist, extract_dir)
     _sdist_extracted_dir.rename(sdist_dir)

     # Change into the new directory
@@ -1131,11 +1160,25 @@
     os.environ.pop("__PYVENV_LAUNCHER__", None)

     _is_debug = "RULES_PYCROSS_DEBUG" in os.environ
-    _temp_dir = Path(tempfile.mkdtemp(prefix="wheelbuild"))
+    _cwd = Path.cwd().resolve()
+    _temp_dir = Path(tempfile.mkdtemp(prefix="wheelbuild", dir=_cwd))
+    _environment = _sandbox_environment(_temp_dir)
+    _previous = {name: os.environ.get(name) for name in _environment}
+    _previous_tempdir = tempfile.tempdir

     try:
+        os.environ.update(_environment)
+        tempfile.tempdir = _environment["TMPDIR"]
         main(args, _temp_dir, _is_debug)
     finally:
+        # Leave the build directory before removing it, including on Windows.
+        os.chdir(_cwd)
+        tempfile.tempdir = _previous_tempdir
+        for name, value in _previous.items():
+            if value is None:
+                os.environ.pop(name, None)
+            else:
+                os.environ[name] = value
         if not _is_debug:
             shutil.rmtree(_temp_dir, ignore_errors=True)

