Resolve C++ toolchain information from the selected execution group.

--- a/pycross/private/cc_toolchain_util.bzl
+++ b/pycross/private/cc_toolchain_util.bzl
@@ -6,6 +6,27 @@
 load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
 load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
 
+CPP_TOOLCHAIN_TYPE = Label("@bazel_tools//tools/cpp:toolchain_type")
+MONGO_PYCROSS_CPP_TOOLCHAIN_TYPE = Label("@@//bazel/toolchains:mongo_pycross_cc_toolchain_type")
+
+def _find_cpp_toolchain(ctx, exec_group):
+    if not exec_group:
+        return find_cpp_toolchain(ctx)
+
+    toolchains = ctx.exec_groups[exec_group].toolchains
+
+    # IBM cross WheelBuild actions use a dedicated toolchain type so that the
+    # target C++ toolchain cannot shadow the execution toolchain used by
+    # ordinary bootstrap/code-generation tools.
+    toolchain_info = toolchains[MONGO_PYCROSS_CPP_TOOLCHAIN_TYPE] if MONGO_PYCROSS_CPP_TOOLCHAIN_TYPE in toolchains else None
+    if toolchain_info == None:
+        toolchain_info = toolchains[CPP_TOOLCHAIN_TYPE] if CPP_TOOLCHAIN_TYPE in toolchains else None
+    if toolchain_info == None:
+        fail("Unable to find a C++ toolchain for execution group %s" % exec_group)
+    if hasattr(toolchain_info, "cc"):
+        return toolchain_info.cc
+    return toolchain_info
+
