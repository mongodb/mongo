 use cargo_build_script_runner::cargo_manifest_dir::{remove_symlink, symlink, RunfilesMaker};
 use cargo_build_script_runner::{BuildScriptOutput, CompileAndLinkFlags};
+
+// Temporary execroot links must also be removed when a build script fails.
+// Otherwise the Windows client cannot download the failed action's outputs.
+#[derive(Default)]
+struct ExecRootLinks(Vec<PathBuf>);
+
+impl ExecRootLinks {
+    fn insert(&mut self, original: &Path, link: &Path) -> Result<(), String> {
+        match symlink(original, link) {
+            Ok(()) => {
+                self.0.push(link.to_owned());
+                Ok(())
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => Ok(()),
+            Err(error) => Err(format!("Failed to create symlink: {error}")),
+        }
+    }
+}
+
+impl Drop for ExecRootLinks {
+    fn drop(&mut self) {
+        for link in self.0.drain(..) {
+            if let Err(error) = remove_symlink(&link) {
+                eprintln!("Failed to remove execroot link {}: {error}", link.display());
+            }
+        }
+    }
+}
 
