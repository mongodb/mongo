load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

# Reproducible Wizer pre-initialization for wasm_wizer (see main.rs).
rust_binary(
    name = "wizer_driver",
    srcs = ["main.rs"],
    edition = "2024",
    deps = [
        "@crates//:tokio",
        "@crates//:wasmtime",
        "@crates//:wasmtime-wasi",
        "@crates//:wasmtime-wizer",
    ],
)
