+def _reown_linker_inputs(ctx, cc_info):
+    """Re-owns the linker inputs of the aspect-generated CcInfo to ctx.label.
+
+    cc_shared_library() (rules_cc) decides which static libraries to link by
+    walking a dependency graph built by an aspect over the rule attribute
+    graph (GraphNodeInfo). The linker inputs produced by the upb aspects are
+    owned by the proto_library() target, which contributes no linker inputs
+    of its own, so cc_shared_library() silently drops them. Any
+    cc_shared_library() link that requires full symbol resolution then fails
+    with undefined upb symbols (for example *_msg_init). Re-owning the
+    linker inputs to this rule's label, which is a regular node in the
+    dependency graph, makes cc_shared_library() link them. Plain binaries
+    are unaffected because they link every linker input of the merged
+    CcInfo regardless of owner.
+    """
+    linker_inputs = []
+    for old_linker_input in cc_info.linking_context.linker_inputs.to_list():
+        # Reuse the original library_to_link values and only change the owner
+        # of the linker input. Recreating the library_to_link objects would
+        # drop LTO metadata (the bitcode member lists) that the LTO indexing
+        # action needs to resolve the .imports file of the link, failing with
+        # "missing bitcode files".
+        linker_inputs.append(cc_common.create_linker_input(
+            owner = ctx.label,
+            libraries = depset(old_linker_input.libraries),
+        ))
+    return CcInfo(
+        compilation_context = cc_info.compilation_context,
+        linking_context = cc_common.create_linking_context(
+            linker_inputs = depset(linker_inputs),
+        ),
+    )
