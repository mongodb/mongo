+def _runfiles_manifest_path(runfiles_root, rel_path):
+  """Returns the manifest target for rel_path, if one is available."""
+  manifest_file = os.environ.get('RUNFILES_MANIFEST_FILE', '')
+  if not os.path.isfile(manifest_file):
+    for candidate in (runfiles_root + '_manifest', join(runfiles_root, 'MANIFEST')):
+      if os.path.isfile(candidate):
+        manifest_file = candidate
+        break
+  if not manifest_file:
+    return None
+
+  rel_path = rel_path.replace('\\', '/')
+  try:
+    with open(manifest_file, 'r') as manifest:
+      for line in manifest:
+        line = line.rstrip('\n')
+        if not line:
+          continue
+        if line.startswith(' '):
+          escaped_link, escaped_target = line[1:].split(' ', 1)
+          link = (escaped_link.replace(r'\s', ' ')
+                  .replace(r'\n', '\n').replace(r'\b', '\\'))
+          target = (escaped_target.replace(r'\s', ' ')
+                    .replace(r'\n', '\n')
+                    .replace(r'\b', '\\'))
+        else:
+          fields = line.split(' ', 1)
+          if len(fields) != 2:
+            continue
+          link, target = fields
+        if link.replace('\\', '/') == rel_path:
+          if IS_WINDOWS:
+            target = target.replace('/', os.sep)
+          return target or link
+  except (OSError, ValueError):
+    return None
+  return None
+
+def _resolve_runfile(runfiles_root, rel_path):
+  path = join(runfiles_root, rel_path)
+  if os.path.exists(path):
+    return path
+  return _runfiles_manifest_path(runfiles_root, rel_path) or path
+
