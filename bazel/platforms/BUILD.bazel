# Define supported build platforms.
load("//bazel/platforms:platform_util.bzl", "setup_platform")

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "mongo_toolchain")

constraint_value(
    name = "use_mongo_toolchain",
    constraint_setting = ":mongo_toolchain",
)

# Marks the auto-generated host platform as using a native/third-party system
# compiler. The native cc toolchain requires this so it never matches on a
# platform configured for the hermetic mongo toolchain.
constraint_setting(name = "native_toolchain")

constraint_value(
    name = "use_native_toolchain",
    constraint_setting = ":native_toolchain",
)

constraint_setting(name = "mongo_linux_cross_toolchain")

constraint_value(
    name = "use_mongo_linux_cross_toolchain",
    constraint_setting = ":mongo_linux_cross_toolchain",
)

constraint_setting(name = "distro")

[
    constraint_value(
        name = distro_or_os,
        constraint_setting = ":distro",
    )
    for distro_or_os in [
        "linux",
        "ubuntu18",
        "ubuntu20",
        "ubuntu22",
        "ubuntu24",
        "amazon_linux_2",
        "amazon_linux_2023",
        "amazon_linux_2023_3",
        "debian10",
        "debian12",
        "debian13",
        "rhel8",
        "rhel9",
        "rhel10",
        "suse12",
        "suse15",
        "suse16",
    ]
]

[
    setup_platform(arch, distro_or_os, cache_silo)
    for arch in [
        "arm64",
        "amd64",
    ]
    for distro_or_os in [
        "linux",
        "ubuntu18",
        "ubuntu20",
        "ubuntu22",
        "ubuntu24",
        "amazon_linux_2",
        "amazon_linux_2023",
        "amazon_linux_2023_3",
        "debian10",
        "debian12",
        "rhel8",
        "rhel9",
        "rhel10",
        "suse15",
    ]
    for cache_silo in [
        "",
        "_cache_silo",
    ]
]

constraint_setting(name = "mongo_windows_toolchain_config")

constraint_value(
    name = "use_mongo_windows_toolchain_config",
    constraint_setting = ":mongo_windows_toolchain_config",
)

constraint_setting(name = "mongo_windows_cross_toolchain")

constraint_value(
    name = "use_mongo_windows_cross_toolchain",
    constraint_setting = ":mongo_windows_cross_toolchain",
)

constraint_setting(name = "mongo_apple_cross_toolchain")

constraint_value(
    name = "use_mongo_native_apple_toolchain",
    constraint_setting = ":mongo_apple_cross_toolchain",
)

constraint_value(
    name = "use_mongo_apple_cross_toolchain",
    constraint_setting = ":mongo_apple_cross_toolchain",
)

# Main-repo handle for the generated host platform. `--platforms` is set to this rather than
# straight to @internal_platforms_do_not_use//host because `bazel info` does not compute the main
# repo mapping, so an apparent repo name in that flag fails to resolve there even though it works
# for build/query.
alias(
    name = "host",
    actual = "@internal_platforms_do_not_use//host",
    visibility = ["//visibility:public"],
)

platform(
    name = "windows_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "windows_x86_64_cross",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        ":use_mongo_windows_cross_toolchain",
    ],
)

config_setting(
    name = "windows_cross",
    constraint_values = [
        "@platforms//os:windows",
        ":use_mongo_windows_cross_toolchain",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
        ":use_mongo_native_apple_toolchain",
    ],
)

platform(
    name = "macos_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
        ":use_mongo_native_apple_toolchain",
    ],
)

# Cross-compilation platforms for building macOS binaries on Linux
# These use the same target constraints as native macOS but are intended
# for use when building from a Linux host.
platform(
    name = "macos_arm64_cross",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
        ":use_mongo_apple_cross_toolchain",
    ],
)

platform(
    name = "macos_x86_64_cross",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
        ":use_mongo_apple_cross_toolchain",
    ],
)

platform(
    name = "linux_ppc64le",
    constraint_values = [
        "@platforms//cpu:ppc64le",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_s390x",
    constraint_values = [
        "@platforms//cpu:s390x",
        "@platforms//os:linux",
    ],
)

platform(
    name = "rhel8_ppc64le",
    constraint_values = [
        "@platforms//cpu:ppc64le",
        "@platforms//os:linux",
        ":use_mongo_toolchain",
        ":rhel8",
    ],
)

platform(
    name = "rhel9_ppc64le",
    constraint_values = [
        "@platforms//cpu:ppc64le",
        "@platforms//os:linux",
        ":use_mongo_toolchain",
        ":rhel9",
    ],
)

platform(
    name = "rhel10_ppc64le",
    constraint_values = [
        "@platforms//cpu:ppc64le",
        "@platforms//os:linux",
        ":use_mongo_toolchain",
        ":rhel10",
    ],
)

platform(
    name = "rhel8_s390x",
    constraint_values = [
        "@platforms//cpu:s390x",
        "@platforms//os:linux",
        ":use_mongo_toolchain",
        ":rhel8",
    ],
)

platform(
    name = "rhel9_s390x",
    constraint_values = [
        "@platforms//cpu:s390x",
        "@platforms//os:linux",
        ":use_mongo_toolchain",
        ":rhel9",
    ],
)

platform(
    name = "rhel10_s390x",
    constraint_values = [
        "@platforms//cpu:s390x",
        "@platforms//os:linux",
        ":use_mongo_toolchain",
        ":rhel10",
    ],
)

[
    platform(
        name = distro + "_" + arch + "_cross",
        constraint_values = [
            "@platforms//cpu:" + arch,
            "@platforms//os:linux",
            ":use_mongo_linux_cross_toolchain",
            ":" + distro,
        ],
    )
    for distro in [
        "rhel8",
        "rhel9",
    ]
    for arch in [
        "ppc64le",
        "s390x",
    ]
]

# WASM platform for WebAssembly compilation
platform(
    name = "wasm32",
    constraint_values = [
        "@platforms//os:wasi",
        "@platforms//cpu:wasm32",
    ],
)

load("@rules_python//python:defs.bzl", "py_binary", "py_test")

py_binary(
    name = "remote_execution_containers_generator",
    srcs = ["remote_execution_containers_generator.py"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "remote_execution_containers_generator_test",
    srcs = ["remote_execution_containers_generator_test.py"],
    data = ["remote_execution_containers_generator.py"],
)

exports_files([
    "remote_execution_containers.bzl",
])
