        "//bazel/config:windows_cross_local_container_actions_enabled": "@bazel_tools//tools/def_parser:def_parser.exe",
        "//conditions:default": "@bazel_tools//tools/def_parser:def_parser",
    }),
    visibility = ["//visibility:public"],
