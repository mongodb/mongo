py_test(
    name = "windows_cross_def_parser_test",
    srcs = ["windows_cross_def_parser_test.py"],
    args = ["$(locations @rules_cc//cc/common:srcs)"],
    data = [
        "BUILD.bazel",
        "@rules_cc//cc/common:srcs",
    ],
)
