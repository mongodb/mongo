+def collect_package_variants(lock_packages, excludes):
+    """Keep URL variants and their markers together under one Bazel target."""
+    grouped = {}
+    for package in lock_packages:
+        name = package["name"]
+        if name.lower() in excludes:
+            continue
+        if package.get("source", {}).get("type", "legacy") not in ["legacy", "url"]:
+            print("Skipping " + name)
+            continue
+        grouped.setdefault(_clean_name(name), []).append(package)
+    return grouped.values()
+
+def lock_marker(package):
+    marker = package.get("markers", package.get("marker", ""))
+    if type(marker) == "dict":
+        values = marker.values()
+        if "" in values:
+            return ""
+        return " or ".join(["(" + value + ")" for value in values])
+    return marker
+
+def locked_requirement(package, fallback_hashes):
+    source = package.get("source", {})
+    if source.get("type") == "url":
+        requirement = package["name"] + " @ " + source["url"]
+    else:
+        requirement = package["name"] + "==" + package["version"]
+    marker = lock_marker(package)
+    if marker:
+        requirement += " ; " + marker
+    hashes = [file["hash"] for file in package["files"]] if "files" in package else fallback_hashes
+    return requirement + " " + " ".join(["--hash=" + digest for digest in hashes])
+
+def package_marker(variants):
+    markers = [lock_marker(package) for package in variants]
+    if "" in markers:
+        return ""
+    return " or ".join(["(" + marker + ")" for marker in markers])
+
 def _impl(repository_ctx):
