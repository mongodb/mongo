FROM opensuse/leap:15.5@sha256:9bd49bd34edb6cc81a47133201f5e7720db3e95ad86eccc4b05afcd83e49dd89

RUN zypper refresh && \
    zypper install -y --no-recommends \
        cyrus-sasl-devel \
        cyrus-sasl-gssapi \
        glibc-devel \
        krb5-devel \
        libcurl-devel \
        libfl2 \
        libopenssl-devel \
        openldap2-devel \
        zip \
    && zypper clean --all

CMD ["/bin/bash"]
