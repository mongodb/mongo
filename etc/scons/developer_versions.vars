def target_mongo_version():
    # FCV generation is driven by the version committed in
    # .bazelrc.target_mongo_version, not by git tags. Read it from there so that
    # local builds agree with what resmoke uses for multiversion testing.
    with open(".bazelrc.target_mongo_version", "r") as version_fh:
        for line in version_fh:
            if "MONGO_VERSION=" in line:
                return line.split("MONGO_VERSION=")[1].strip()
    raise ValueError("MONGO_VERSION not found in .bazelrc.target_mongo_version")

MONGO_GIT_HASH="unknown"
MONGO_VERSION=target_mongo_version()
