load("//bazel:mongo_src_rules.bzl", "symlink")

package(default_visibility = ["//visibility:public"])

exports_files([
    "evergreen_yml_components/tasks/compile_tasks.yml",
    "lsan.suppressions",
    "tsan.suppressions",
])

filegroup(
    name = "evergreen_release_distro_test_data",
    srcs = glob(["evergreen_yml_components/variants/**/test_release*.yml"]),
)

# This is a hack to work around the fact that the cc_library flag additional_compiler_inputs doesn't
# exist in cc_binary. Instead, we add the denylists to srcs as header files to make them visible to
# the compiler executable.
symlink(
    name = "asan_denylist_h",
    input = "asan.denylist",
    output = "asan.denylist.h",
)

symlink(
    name = "msan_denylist_h",
    input = "msan.denylist",
    output = "msan.denylist.h",
)

symlink(
    name = "tsan_denylist_h",
    input = "tsan.denylist",
    output = "tsan.denylist.h",
)

symlink(
    name = "ubsan_denylist_h",
    input = "ubsan.denylist",
    output = "ubsan.denylist.h",
)

filegroup(
    name = "mac_plist",
    srcs = ["macos_mongodb.plist"],
)

filegroup(
    name = "evergreen_s390x_cross_test_data",
    srcs = glob(["evergreen_yml_components/tasks/**/*.yml"]) + [
        "evergreen_yml_components/definitions.yml",
        "evergreen_yml_components/variants/ibm/test_release_master_and_lts_branches_only.yml",
    ],
)
