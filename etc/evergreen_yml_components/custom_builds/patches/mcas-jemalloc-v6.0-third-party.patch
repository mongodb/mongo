diff --git a/src/third_party/jemalloc/SConscript b/src/third_party/jemalloc/SConscript
new file mode 100644
index 00000000000..e5c44aee89f
--- /dev/null
+++ b/src/third_party/jemalloc/SConscript
@@ -0,0 +1,79 @@
+import subprocess
+import os
+
+Import("env")
+Import("debugBuild")
+
+
+env = env.Clone()
+
+env.InjectThirdParty('valgrind')
+
+files = [
+    'dist/src/arena.c',
+    'dist/src/atomic.c',
+    'dist/src/base.c',
+    'dist/src/bitmap.c',
+    'dist/src/chunk.c',
+    'dist/src/chunk_dss.c',
+    'dist/src/chunk_mmap.c',
+    'dist/src/ckh.c',
+    'dist/src/ctl.c',
+    'dist/src/extent.c',
+    'dist/src/hash.c',
+    'dist/src/huge.c',
+    'dist/src/jemalloc.c',
+    'dist/src/mb.c',
+    'dist/src/mutex.c',
+    'dist/src/nstime.c',
+    'dist/src/pages.c',
+    'dist/src/prng.c',
+    'dist/src/prof.c',
+    'dist/src/quarantine.c',
+    'dist/src/rtree.c',
+    'dist/src/spin.c',
+    'dist/src/stats.c',
+    'dist/src/tcache.c',
+    'dist/src/ticker.c',
+    'dist/src/tsd.c',
+    'dist/src/util.c',
+    'dist/src/valgrind.c',
+    'dist/src/witness.c',
+]
+
+if env.TargetOSIs('osx'):
+    files += [
+        'dist/src/zone.c'
+    ]
+elif env.TargetOSIs('linux'):
+    env.Append(
+        CPPDEFINES=["_GNU_SOURCE"],
+        CCFLAGS=['-Wno-ignored-attributes'])
+
+if debugBuild:
+    env.Append( CPPDEFINES=["JEMALLOC_DEBUG"] )
+
+
+
+# Stolen from gperftools SConscript file.
+env.Prepend( CPPPATH=["dist/include/"] )
+
+def removeIfPresent(lst, item):
+    try:
+        lst.remove(item)
+    except ValueError:
+        pass
+
+# JEMalloc uses the 'asm' symbol which isn't defined in c99
+for to_remove in ['-std=c11']:
+   removeIfPresent(env['CFLAGS'], to_remove)
+
+env['CFLAGS'].append('-std=gnu11')
+
+if not os.path.exists(env.File('#/src/third_party/jemalloc/dist/include/jemalloc/internal/jemalloc_internal.h').abspath):
+    subprocess.run(["./configure"], cwd=env.Dir('#/src/third_party/jemalloc/dist').abspath)
+
+env.Library(
+    target='jemalloc',
+    source=files,
+)
\ No newline at end of file
