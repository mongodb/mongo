# Redirect Python bytecode caches out of Bazel-managed trees. The toolchain repo
# ships a usercustomize.py that sets sys.pycache_prefix, but that only runs during
# site initialization -- after the interpreter has already imported `encodings`,
# whose .pyc files then land in the fetched python toolchain repo and make Bazel
# re-fetch it ("will be fetched again since the file ... has been modified
# externally"). PYTHONPYCACHEPREFIX is honored from startup, so it covers those.
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-${TMPDIR:-/tmp}/bazel_pycache}"

