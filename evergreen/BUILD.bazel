load("@poetry//:dependencies.bzl", "dependency")

py_test(
    name = "bazel_compile_test",
    srcs = ["bazel_compile_test.py"],
    data = [
        "bazel_compile.sh",
        "bazel_evergreen_shutils.sh",
        "//etc:evergreen_release_distro_test_data",
        "//etc:evergreen_yml_components/tasks/compile_tasks.yml",
    ],
    deps = [
        "//bazel/wrapper_hook:release_distro",
        dependency(
            "pyyaml",
            group = "core",
        ),
    ],
)

exports_files(
    ["bazel_evergreen_shutils.sh"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "all_python_files",
    srcs = glob(["*.py"]),
    visibility = ["//visibility:public"],
    deps = [
        dependency(
            "requests",
            group = "core",
        ),
    ],
)

sh_test(
    name = "prelude_workdir_test",
    srcs = ["prelude_workdir_test.sh"],
    data = ["prelude_workdir.sh"],
)
