load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//bazel/uv:defs.bzl", "dependency")

package(default_visibility = ["//visibility:public"])

# test_resmoke_js_debugger.py drives resmoke through a pty. Suites depend on this for the
# PyInfo, which is what puts pexpect on the PYTHONPATH of the test subprocess.
py_library(
    name = "js_debugger_test_deps",
    deps = [
        dependency(
            "pexpect",
            group = "testing",
        ),
    ],
)

# TODO(SERVER-105817): The following library is autogenerated, please split these out into individual python targets
py_library(
    name = "all_python_files",
    srcs = glob(["*.py"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
)

# Everything the tests in this package reference at runtime: the suites they hand to the
# nested resmoke invocations, plus the fixtures, hooks and test files those suites name.
filegroup(
    name = "all_test_data",
    srcs = [
        ":all_files",
        "//buildscripts/tests/resmoke_end2end/failtestfiles:all_files",
        "//buildscripts/tests/resmoke_end2end/fixtures:all_files",
        "//buildscripts/tests/resmoke_end2end/hooks:all_files",
        "//buildscripts/tests/resmoke_end2end/test_external_module_fixtures_hooks/fixtures:all_files",
        "//buildscripts/tests/resmoke_end2end/test_external_module_fixtures_hooks/hooks:all_files",
        "//buildscripts/tests/resmoke_end2end/testfiles:all_files",
    ],
)
