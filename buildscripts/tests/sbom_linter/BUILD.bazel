load("//bazel/uv:defs.bzl", "dependency")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

_DEPS = [
    dependency(
        "jsonschema",
        group = "build-metrics",
    ),
    dependency(
        "license-expression",
        group = "lint",
    ),
    dependency(
        "pyyaml",
        group = "core",
    ),
]

py_library(
    name = "sbom_linter_lib",
    srcs = ["sbom_linter.py"],
    data = glob(["*.schema.json"]),
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

py_binary(
    name = "sbom_linter",
    srcs = ["sbom_linter.py"],
    data = glob(["*.schema.json"]),
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

py_test(
    name = "test_sbom",
    srcs = ["test_sbom.py"],
    data = glob(["*.schema.json"]) + ["//buildscripts/tests/sbom_linter/inputs:test_data"],
    visibility = ["//visibility:public"],
    deps = [":sbom_linter_lib"],
)
