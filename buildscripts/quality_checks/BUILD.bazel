load("//bazel/uv:defs.bzl", "dependency")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "quality_checks_lib",
    srcs = [
        "__init__.py",
        "adapters.py",
        "cli.py",
        "engine.py",
        "manifest.py",
        "models.py",
        "progress.py",
        "selection.py",
        "telemetry.py",
    ],
    deps = [
        "//bazel/wrapper_hook",
        "//buildscripts:bazel_custom_formatter",
        "@bazel_rules_mongo//utils:evergreen_git",
        dependency(
            "gitpython",
            group = "wrapper-hook",
        ),
        dependency(
            "opentelemetry-api",
            group = "wrapper-hook",
        ),
        dependency(
            "opentelemetry-sdk",
            group = "wrapper-hook",
        ),
    ] + select({
        "@platforms//cpu:ppc64le": [],
        "@platforms//cpu:s390x": [],
        "//conditions:default": [dependency(
            "opentelemetry-exporter-otlp-proto-grpc",
            group = "wrapper-hook",
        )],
    }),
)

py_binary(
    name = "quality_checks",
    srcs = ["cli.py"],
    main = "cli.py",
    deps = [":quality_checks_lib"],
)

py_test(
    name = "quality_checks_test",
    srcs = ["quality_checks_test.py"],
    deps = [":quality_checks_lib"],
)
