load("//bazel:mongo_src_rules.bzl", "mongo_cc_library", "mongo_cc_unit_test")

package(default_visibility = ["//visibility:public"])

mongo_cc_library(
    name = "metrics_primitives",
    hdrs = ["metrics_primitives.h"],
    deps = [
        "//src/mongo:base",
    ],
)

mongo_cc_unit_test(
    name = "metrics_primitives_test",
    srcs = ["metrics_primitives_test.cpp"],
    tags = ["mongo_unittest_first_group"],
    deps = [
        ":metrics_primitives",
        # Test-only to pull in OperationLatencyHistogram's inclusive lower bounds.
        "//src/mongo/db/stats:top",
        "//src/mongo/unittest",
    ],
)
