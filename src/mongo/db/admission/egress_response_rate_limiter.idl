global:
    mod_visibility: public
    cpp_namespace: "mongo::admission"
    cpp_includes:
        - "mongo/db/admission/egress_response_rate_limiter.h"
        - "mongo/db/server_options.h"

imports:
    - "mongo/db/basic_types.idl"

server_parameters:
    egressResponseRateLimiterEnabled:
        description: >-
            Controls whether the egress response rate limiter mechanism is enabled. This is
            independent of ingressRequestRateLimiterEnabled, so the ingress request limiter may be
            enabled without also pacing the rejection replies it produces.
        set_at: [startup, runtime]
        cpp_varname: gEgressResponseRateLimiterEnabled
        cpp_vartype: Atomic<bool>
        default: false
        redact: false

    egressResponseRateLimiterRatePerSec:
        description: >-
            The number of egress responses permitted per second. This rate defaults to the maximum
            int32 value, so enabling the limiter without also lowering this rate leaves it an
            effective no-op.
        set_at: [startup, runtime]
        cpp_varname: gEgressResponseRateLimiterRatePerSec
        cpp_vartype: Atomic<int32_t>
        on_update: EgressResponseRateLimiter::onUpdateRatePerSec
        default:
            expr: std::numeric_limits<int32_t>::max()
        validator: {gte: 1}
        redact: false

    egressResponseRateLimiterBurstCapacitySecs:
        description: >-
            Describes how many seconds worth of unutilized rate limit can be stored away to permit
            additional egress responses during periods where the rate limit is temporarily
            exceeded. Defaults to the maximum double value (effectively unbounded).
        set_at: [startup, runtime]
        cpp_varname: gEgressResponseRateLimiterBurstCapacitySecs
        cpp_vartype: Atomic<double>
        on_update: EgressResponseRateLimiter::onUpdateBurstCapacitySecs
        default:
            expr: std::numeric_limits<double>::max()
        validator: {gt: 0}
        redact: false

    egressResponseRateLimiterMaxQueueDepth:
        description: >-
            The maximum number of egress responses that may be queued waiting for a token when
            the egress response rate limit is exceeded. Responses that arrive when the queue is
            at capacity bypass the queue and are sent immediately (fail-open), preserving the
            invariant that a rejection reply is never dropped. A value of 0 disables queueing.
        set_at: [startup, runtime]
        cpp_varname: gEgressResponseRateLimiterMaxQueueDepth
        cpp_vartype: Atomic<long long>
        on_update: EgressResponseRateLimiter::onUpdateMaxQueueDepth
        default:
            expr: std::numeric_limits<long long>::max()
        validator: {gte: 0}
        redact: false
