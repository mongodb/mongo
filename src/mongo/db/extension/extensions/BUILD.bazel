load("//bazel/install_rules:install_rules.bzl", "extensions_with_config")
load("//bazel:mongo_src_rules.bzl", "mongo_cc_extension_shared_library")
load("//bazel/uv:defs.bzl", "dependency")
load("//bazel/config:python_genrule.bzl", "python_genrule")

package(default_visibility = ["//visibility:public"])

# mongot-extension
[
    python_genrule(
        name = "download_" + extension_name + "_" + variant,
        srcs = [
            "//etc:extensions.yml",
        ],
        cmd = [
            "--extension-name",
            extension_name,
            "--conf-file",
            "$(location //etc:extensions.yml)",
            "--variant",
            variant,
            "--archive-files",
            extension_name.replace("_", "-") + ".so",
            extension_name.replace("_", "-") + ".so.sig",
            "--outputs",
            "$(location " + extension_name + "_" + variant + ".so)",
            "$(location " + extension_name + "_" + variant + ".so.sig)",
        ],
        outputs = [
            extension_name + "_" + variant + ".so",
            extension_name + "_" + variant + ".so.sig",
        ],
        python_file = "download_external_extension.py",
        python_libs = [
            dependency(
                "pyyaml",
                group = "core",
            ),
            dependency(
                "requests",
                group = "core",
            ),
            dependency(
                "retry",
                group = "testing",
            ),
        ],
    )
    for extension_name in [
        "mongot_extension",
        "rerank_extension",
    ]
    # amazon2023 artifacts only load on AL2023 hosts; the amazon2 ones link against the older AL2
    # glibc and are what the other Linux distros use (see include_files in //:BUILD.bazel).
    for variant in [
        "amazon2023-x86_64",
        "amazon2023-aarch64",
        "amazon2-x86_64",
        "amazon2-aarch64",
    ]
]
