global:
    cpp_namespace: "mongo"
    mod_visibility: private

imports:
    - "mongo/db/basic_types.idl"

structs:
    NdvSketch:
        description: >-
            A single HyperLogLog sketch document persisted in system.stats.field_stats.
        strict: true
        fields:
            ndv:
                type: long
            registers:
                type: bindata_generic
            precision:
                type: int
