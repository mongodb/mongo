load("//bazel:mongo_src_rules.bzl", "idl_generator", "mongo_cc_library", "mongo_cc_unit_test")

package(default_visibility = ["//visibility:public"])

exports_files(
    glob([
        "*.h",
        "*.cpp",
    ]),
)

mongo_cc_library(
    name = "persistent_stats_manager",
    hdrs = [
        "persistent_stats_manager.h",
    ],
    deps = [
        "//src/mongo:base",
    ],
)

idl_generator(
    name = "persistent_stats_config_gen",
    src = "persistent_stats_config.idl",
    hdrs = [
        "persistent_stats_config_serialization.h",
    ],
    deps = [
        "//src/mongo/db:basic_types_gen",
    ],
)

mongo_cc_library(
    name = "persistent_stats_config",
    srcs = [
        "persistent_stats_config_serialization.cpp",
        "persistent_stats_config_update.cpp",
        "persistent_stats_config_validation.cpp",
        ":persistent_stats_config_gen",
    ],
    hdrs = [
        "persistent_stats_config_serialization.h",
        "persistent_stats_config_update.h",
        "persistent_stats_config_validation.h",
    ],
    deps = [
        "//src/mongo/db:server_base",
        "//src/mongo/db:server_feature_flags",
        "//src/mongo/db/query:query_knobs",
    ],
)

mongo_cc_unit_test(
    name = "persistent_stats_config_update_test",
    srcs = [
        "persistent_stats_config_update_test.cpp",
    ],
    tags = ["mongo_unittest_second_group"],
    deps = [
        ":persistent_stats_config",
        "//src/mongo/unittest",
    ],
)

mongo_cc_unit_test(
    name = "persistent_stats_config_validation_test",
    srcs = [
        "persistent_stats_config_validation_test.cpp",
    ],
    tags = ["mongo_unittest_sixth_group"],
    deps = [
        ":persistent_stats_config",
        "//src/mongo/db:server_base",
        "//src/mongo/db:service_context_test_fixture",
        "//src/mongo/unittest",
        "//src/mongo/unittest:server_parameter_guard",
    ],
)
