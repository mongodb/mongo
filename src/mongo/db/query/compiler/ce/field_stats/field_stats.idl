global:
    cpp_namespace: "mongo::ce"
    mod_visibility: private

imports:
    - "mongo/db/basic_types.idl"
    - "mongo/db/query/compiler/ce/field_stats/ndv_sketch.idl"
    - "mongo/db/query/compiler/ce/field_stats/mcv_sketch.idl"

structs:
    NdvStats:
        description: >-
            The NDV section of a field-stats document, excluding documents with array traversal
            or terminal object values at any analyzed path.
        strict: false
        fields:
            sketches:
                # One sketch per null/missing folding variant, positionally keyed off the
                # canonically sorted field paths: a single field persists exactly one strict
                # sketch ($expr semantics, missing distinct from null); n >= 2 fields persist
                # n + 2, the all-strict tuple sketch first, then per field the variant folding
                # that field's missing values into null, followed by all-match (folding all fields).
                type: array<NdvSketch>

    McvStats:
        description: "The MCV section of a field-stats document."
        strict: false
        fields:
            sketches:
                # One sketch per field, in the canonical path order in _id, including empty sketches.
                type: array<McvSketch>

    FieldStatsDoc:
        description: >-
            On-disk document stored in <db>.system.stats.fieldStats holding per-field
            statistics. Written by the analyze command and consumed by the optimizer's read
            path. Each statistic kind lives in its own top-level section so more can be added
            over time.
        strict: false
        fields:
            _id:
                # Canonical id string built by makeFieldStatsId(); a string key avoids the
                # field-order sensitivity of BSON object equality.
                type: string
            schemaVersion:
                type: int
                validator: {gte: 1}
            collectedAt:
                type: date
            totalDocs:
                description: "Documents observed by the scan."
                type: long
                validator: {gte: 0}
            # Singleton categories are disjoint; composite special-value categories may overlap.
            nonScalarDocs:
                description: >-
                    Documents with an array along or an array/object at any analyzed path,
                    or exceeding the extraction tuple limit.
                type: long
                validator: {gte: 0}
            nullDocs:
                description: "Sketch-eligible documents with explicit null at any analyzed path."
                type: long
                validator: {gte: 0}
            missingDocs:
                description: "Sketch-eligible documents with an analyzed path yielding Nothing."
                type: long
                validator: {gte: 0}
            undefinedDocs:
                description: "Sketch-eligible documents with BSON Undefined at any analyzed path."
                type: long
                validator: {gte: 0}
            ndv:
                type: NdvStats
            mcv:
                type: McvStats
