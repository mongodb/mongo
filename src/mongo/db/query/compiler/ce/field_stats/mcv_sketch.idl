global:
    cpp_namespace: "mongo::ce"
    mod_visibility: private

imports:
    - "mongo/db/basic_types.idl"

structs:
    McvEntry:
        description: "A most common value with its estimated count and overestimation bound."
        strict: false
        fields:
            value:
                type: IDLAnyTypeOwned
            estFreq:
                type: long
                validator: {gte: 1}
            err:
                type: long
                validator: {gte: 0}

    McvSketch:
        description: "A field's most common values, sorted by ascending BSON value order."
        strict: false
        fields:
            entries:
                type: array<McvEntry>
