global:
    cpp_namespace: "mongo"
    mod_visibility: public

server_parameters:
    featureCompatibilityVersion:
        description: "Read-only view of current Feature Compatability Version"
        set_at: "readonly"
        cpp_class:
            name: FeatureCompatibilityVersionParameter
        redact: false

    defaultStartupFCV:
        description: >
            Startup parameter to set a default FCV at startup. This parameter is also settable at
            runtime because Atlas uses a declarative configuration model that always specifies it,
            including when changing the FCV with setFeatureCompatibilityVersion. Changing this
            parameter at runtime does not change the current FCV, and allows Atlas to apply its
            configuration without requiring a restart.
        set_at: [startup, runtime]
        cpp_vartype: synchronized_value<std::string>
        cpp_varname: gDefaultStartupFCV
        redact: false
