global:
    cpp_namespace: "mongo"

imports:
    - "mongo/db/basic_types.idl"
    - "mongo/db/metrics_category.idl"
    - "mongo/idl/generic_argument.idl"

structs:
    GetMetricsFilteringAllowlistReply:
        description: "Reply for getMetricsFilteringAllowlist command"
        is_command_reply: true
        fields:
            allowlist:
                description: "Array of metric paths in the allowlist"
                type: array<string>

commands:
    getMetricsFilteringAllowlist:
        description: "Command to get the metrics filtering allowlist for a specific category"
        command_name: getMetricsFilteringAllowlist
        namespace: ignored
        api_version: ""
        fields:
            category:
                description: "Metrics category"
                type: MetricsCategory
        reply_type: GetMetricsFilteringAllowlistReply
