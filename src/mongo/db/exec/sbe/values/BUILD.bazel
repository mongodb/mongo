load("//bazel:mongo_src_rules.bzl", "mongo_cc_fuzztest", "mongo_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(
    glob([
        "*.h",
        "*.cpp",
    ]),
)

mongo_cc_fuzztest(
    name = "sbe_value_fuzz_test",
    srcs = ["sbe_value_fuzz_test.cpp"],
    deps = [
        ":document_tree_generator",
        "//src/mongo/db:sbe_values",
    ],
)

mongo_cc_library(
    name = "document_tree_generator",
    testonly = True,
    srcs = ["document_tree_generator.cpp"],
    hdrs = ["document_tree_generator.h"],
    # The fuzztest domain declarations in the header trip -Wsign-compare inside the library's own
    # headers; mongo_cc_fuzztest binaries carry the same suppression.
    copts = ["-Wno-sign-compare"],
    deps = [
        "//src/mongo:base",
        "@fuzztest//fuzztest",
    ],
)
