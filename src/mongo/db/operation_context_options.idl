global:
    cpp_namespace: "mongo"
    mod_visibility: public

server_parameters:
    overdueInterruptCheckIntervalMillis:
        description: >-
            The interval in milliseconds after which an interrupt check is considered overdue.
            Interrupt checks are only tracked for a sample of operations.
        set_at: [startup, runtime]
        cpp_vartype: Atomic<int32_t>
        cpp_varname: gOverdueInterruptCheckIntervalMillis
        default: 30
        validator:
            gte: 10
        redact: false

    overdueInterruptCheckSamplingRate:
        description: >-
            The fraction of operations where time between interrupt checks are tracked.
        set_at: [startup, runtime]
        cpp_vartype: Atomic<double>
        cpp_varname: gOverdueInterruptCheckSamplingRate
        default: 0.001
        validator:
            gte: 0
            lte: 1
        redact: false

    operationCPUTimingEnabled:
        description: >-
            Whether to measure the CPU time consumed by each operation. On Linux this costs two
            clock_gettime(CLOCK_THREAD_CPUTIME_ID) system calls per operation. When false, new
            operations do not report cpuNanos (slow query log, profiler, $currentOp, query stats)
            and do not contribute to the CPU usage counters of execution control statistics.
        set_at: [startup, runtime]
        cpp_vartype: Atomic<bool>
        cpp_varname: gOperationCPUTimingEnabled
        default: true
        redact: false
