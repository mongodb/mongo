load("//bazel/config:render_template.bzl", "render_template")
load("//bazel:mongo_src_rules.bzl", "mongo_cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(
    glob([
        "*.js",
    ]),
)

# Server-specific copies of the shell setup scripts, converted to classic (non-module) scripts so
# the server JS scope can be initialized without the filesystem-backed module loader. Each entry is
# (C++ symbol name, source file); the "server_" prefix keeps these JSFiles symbols distinct from the
# shell's (e.g. JSFiles::assert), which would otherwise collide at link time.
SERVER_CPP_JSFILES = [
    ("server_assert", "assert.js"),
]

render_template(
    name = "server_jsfiles_cpp",
    srcs = [file for _, file in SERVER_CPP_JSFILES],
    cmd = [
        "$(location server_jsfiles.cpp)",
    ] + [
        item
        for name, file in SERVER_CPP_JSFILES
        for item in [
            "--module",
            name,
            "$(location {})".format(file),
        ]
    ],
    output = "server_jsfiles.cpp",
    python_file = "//buildscripts:jstoh.py",
)

mongo_cc_library(
    name = "server_jsfiles",
    srcs = [
        "server_jsfiles.cpp",
    ],
    # This package has no on-disk C++ sources (only the generated server_jsfiles.cpp), so the
    # auto_header generator never produces a .auto_header subpackage here. Disable auto_header and
    # instead depend on //src/mongo/shell:mongojs, which transitively provides mongo/scripting/
    # engine.h (the JSFile declaration the generated file needs). mongojs only depends on
    # //src/mongo:base, so this does not create a cycle with scripting_common.
    auto_header = False,
    deps = [
        "//src/mongo:base",
        "//src/mongo/shell:mongojs",
    ],
)
